+test("a completed navigation reapplies its hidden turn viewport after the DOM-ready emulation was reset", () => {
+  const contents = new EventEmitter();
+  let emulations = 0, effectiveWidth = 0;
+  contents.setWindowOpenHandler = () => {};
+  contents.isDestroyed = () => false;
+  contents.getURL = () => "https://chatgpt.com/";
+  contents.enableDeviceEmulation = options => { emulations++;effectiveWidth = options.viewSize.width; };
+  const tab = {
+    id: "late-navigation-viewport", status: "running", interactionMode: "automatic", initializingSurface: true,
+    rendererReady: false, deviceEmulationDirty: true, deviceEmulationViewport: null,
+    view: { webContents: contents, setBounds() {}, setVisible() {} },
+  };
+  const fixture = Object.assign(Object.create(BrowserHost.prototype), {
+    turnTabs: new Map([[tab.id, tab]]),
+    hiddenTurnBounds: () => ({ x: 1425, y: 922, width: 1424, height: 921 }),
+    syncViewVisibility() { this.presentTurnView(tab, false); },
+    snapshot: () => ({}), publishState() {},
+    getBrowserInteractionMode: () => "automatic",
+  });
+  fixture.bindTurnContents(tab);
+  contents.emit("did-start-navigation", {}, "https://chatgpt.com/", false, true);
+  contents.emit("dom-ready");
+  assert.equal(emulations, 1);assert.equal(effectiveWidth, 1424);
+  assert.equal(tab.deviceEmulationDirty, false);
+  // Chromium can discard effective emulation after DOM-ready without changing
+  // the launcher's cached dimensions. Load completion must restore the contract.
+  effectiveWidth = 0;
+  contents.emit("did-finish-load");
+  assert.equal(emulations, 2);assert.equal(effectiveWidth, 1424);
+  assert.deepEqual(tab.deviceEmulationViewport, { width: 1424, height: 921 });
+  assert.equal(tab.deviceEmulationDirty, false);
+});

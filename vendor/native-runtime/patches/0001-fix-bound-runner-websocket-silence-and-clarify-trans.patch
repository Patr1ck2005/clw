+#[tokio::test]
+async fn websocket_liveness_pongs_keep_real_socket_alive() {
+    for native_control_pong in [false, true] {
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let server = tokio::spawn(async move {
+            let (stream, _) = listener.accept().await.unwrap();
+            let mut ws = tokio_tungstenite::accept_async(stream).await.unwrap();
+            read_register(&mut ws).await;
+            send_registered_ack(&mut ws).await;
+            let mut pings = 0;
+            while pings < 14 {
+                if let RunnerEnvelope::Ping { ts } = read_loopback_envelope(&mut ws).await {
+                    pings += 1;
+                    // Drop one reply, as permitted when the Server is busy.
+                    if pings != 4 {
+                        let pong = if native_control_pong {
+                            WsMessage::Pong(vec![1].into())
+                        } else {
+                            WsMessage::Text(RunnerEnvelope::Pong { ts }.to_json().unwrap().into())
+                        };
+                        ws.send(pong).await.unwrap();
+                    }
+                }
+            }
+            ws.send(WsMessage::Close(None)).await.unwrap();
+            pings
+        });
+        let cfg = test_runner_config(format!("http://{addr}"));
+        let runtime = test_runtime(&cfg);
+        let started = Instant::now();
+        let exit = tokio::time::timeout(
+            Duration::from_secs(5),
+            websocket_session_with_liveness(
+                &cfg,
+                vec![test_project("pongs")],
+                "inst-pongs",
+                &runtime,
+                short_websocket_liveness(),
+                std::future::pending::<()>(),
+            ),
+        )
+        .await
+        .expect("Pong loopback did not complete")
+        .unwrap();
+        assert_eq!(exit, RunnerSessionExit::TransportDisconnected);
+        assert!(started.elapsed() > short_websocket_liveness().inbound_idle_timeout);
+        assert_eq!(server.await.unwrap(), 14);
+        assert!(!runtime.shutdown_requested());
+    }
+}
+#[tokio::test]
+async fn websocket_liveness_other_inbound_activity_extends_until_last_frame() {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    let (last_activity_tx, last_activity_rx) = oneshot::channel();
+    let server = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await.unwrap();
+        let mut ws = tokio_tungstenite::accept_async(stream).await.unwrap();
+        read_register(&mut ws).await;
+        send_registered_ack(&mut ws).await;
+        for ts in 0..10 {
+            tokio::time::sleep(Duration::from_millis(80)).await;
+            ws.send(WsMessage::Text(
+                RunnerEnvelope::Ping { ts }.to_json().unwrap().into(),
+            ))
+            .await
+            .unwrap();
+            loop {
+                match read_loopback_envelope(&mut ws).await {
+                    RunnerEnvelope::Pong { ts: reply } if reply == ts => break,
+                    RunnerEnvelope::Goodbye { .. } => panic!("inbound activity requested shutdown"),
+                    _ => {}
+                }
+            }
+        }
+        // Runner Pong is a processing barrier for the last inbound Ping.
+        last_activity_tx.send(Instant::now()).unwrap();
+        while let Some(Ok(message)) = ws.next().await {
+            if message.is_text() {
+                assert!(!matches!(
+                    RunnerEnvelope::from_slice(message.into_text().unwrap().as_bytes()).unwrap(),
+                    RunnerEnvelope::Goodbye { .. }
+                ));
+            }
+        }
+    });
+    let cfg = test_runner_config(format!("http://{addr}"));
+    let runtime = test_runtime(&cfg);
+    let exit = tokio::time::timeout(
+        Duration::from_secs(5),
+        websocket_session_with_liveness(
+            &cfg,
+            vec![test_project("activity")],
+            "inst-activity",
+            &runtime,
+            short_websocket_liveness(),
+            std::future::pending::<()>(),
+        ),
+    )
+    .await
+    .expect("active inbound peer did not finish after becoming silent")
+    .unwrap();
+    assert_eq!(exit, RunnerSessionExit::TransportDisconnected);
+    let silence = last_activity_rx.await.unwrap().elapsed();
+    assert!(
+        silence >= Duration::from_millis(350),
+        "deadline was not renewed by inbound activity"
+    );
+    assert!(!runtime.shutdown_requested());
+    server.await.unwrap();
+}

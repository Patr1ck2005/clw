+#[tokio::test]
+async fn websocket_liveness_stuck_writer_times_out_and_drops_without_retry() {
+    struct SendDrop(Arc<AtomicBool>);
+    impl Drop for SendDrop {
+        fn drop(&mut self) {
+            self.0.store(true, Ordering::SeqCst);
+        }
+    }
+    let dropped = Arc::new(AtomicBool::new(false));
+    let calls = Arc::new(AtomicUsize::new(0));
+    let send_dropped = dropped.clone();
+    let send_calls = calls.clone();
+    // A deterministic stalled flush tests the production writer, without
+    // depending on operating-system TCP buffer size to force backpressure.
+    let sink = Box::pin(futures_util::sink::unfold((), move |(), _: WsMessage| {
+        let send_dropped = send_dropped.clone();
+        let send_calls = send_calls.clone();
+        async move {
+            send_calls.fetch_add(1, Ordering::SeqCst);
+            let _drop = SendDrop(send_dropped);
+            std::future::pending::<Result<(), std::convert::Infallible>>().await
+        }
+    }));
+    let (tx, rx) = mpsc::channel(1);
+    tx.send(RunnerEnvelope::Ping { ts: 1 }).await.unwrap();
+    let mut liveness = short_websocket_liveness();
+    liveness.send_timeout = Duration::from_millis(50);
+    let exit = tokio::time::timeout(
+        Duration::from_secs(1),
+        write_websocket_envelopes(sink, rx, liveness),
+    )
+    .await
+    .expect("stalled writer did not release its sink");
+    assert_eq!(exit, StreamWriterExit::TransportFailed);
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    assert!(
+        dropped.load(Ordering::SeqCst),
+        "cancelled send/sink was retained"
+    );
+    assert!(tx.send(RunnerEnvelope::Ping { ts: 2 }).await.is_err());
+}

+#[tokio::test]
+async fn websocket_liveness_long_silent_job_survives_with_pongs() {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    let cwd = tempfile::tempdir().unwrap();
+    let command = if cfg!(windows) {
+        "Start-Sleep -Milliseconds 1400; [Console]::Out.Write('job-complete')"
+    } else {
+        "sleep 1.4; printf job-complete"
+    };
+    let mut request = start_job_request(cwd.path(), command);
+    request.timeout_secs = 10;
+    let server = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await.unwrap();
+        let mut ws = tokio_tungstenite::accept_async(stream).await.unwrap();
+        read_register(&mut ws).await;
+        send_registered_ack(&mut ws).await;
+        ws.send(WsMessage::Text(
+            RunnerEnvelope::Request { request }
+                .to_json()
+                .unwrap()
+                .into(),
+        ))
+        .await
+        .unwrap();
+        let mut saw_running = false;
+        let mut pings = 0;
+        loop {
+            match read_loopback_envelope(&mut ws).await {
+                RunnerEnvelope::Ping { ts } => {
+                    pings += 1;
+                    ws.send(WsMessage::Text(
+                        RunnerEnvelope::Pong { ts }.to_json().unwrap().into(),
+                    ))
+                    .await
+                    .unwrap();
+                }
+                RunnerEnvelope::JobUpdate { payload } if payload.job_id == "job-active" => {
+                    saw_running |= payload.status == "running";
+                    if payload.finished {
+                        assert_eq!(payload.exit_code, Some(0));
+                        assert!(saw_running);
+                        break;
+                    }
+                }
+                RunnerEnvelope::Goodbye { .. } => panic!("long Job requested process shutdown"),
+                _ => {}
+            }
+        }
+        ws.send(WsMessage::Close(None)).await.unwrap();
+        pings
+    });
+    let cfg = test_runner_config(format!("http://{addr}"));
+    let runtime = test_runtime(&cfg);
+    let exit = tokio::time::timeout(
+        Duration::from_secs(12),
+        websocket_session_with_liveness(
+            &cfg,
+            vec![test_project("long-job")],
+            "inst-long-job",
+            &runtime,
+            short_websocket_liveness(),
+            std::future::pending::<()>(),
+        ),
+    )
+    .await
+    .expect("long Job socket was interrupted or failed to deliver terminal update")
+    .unwrap();
+    assert_eq!(exit, RunnerSessionExit::TransportDisconnected);
+    assert!(server.await.unwrap() >= 12);
+    assert!(!runtime.shutdown_requested());
+    assert!(!runtime.jobs.has_work());
+}

+async fn websocket_liveness_no_pong_disconnects_without_shutdown_or_goodbye() {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    let server = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await.unwrap();
+        let mut ws = tokio_tungstenite::accept_async(stream).await.unwrap();
+        read_register(&mut ws).await;
+        send_registered_ack(&mut ws).await;
+        let mut pings = 0;
+        // Keep reading the real TCP socket so writes succeed, but deliberately
+        // withhold application Pongs while retaining the connected socket.
+        while let Some(Ok(message)) = ws.next().await {
+            if message.is_text() {
+                match RunnerEnvelope::from_slice(message.into_text().unwrap().as_bytes()).unwrap() {
+                    RunnerEnvelope::Ping { .. } => pings += 1,
+                    RunnerEnvelope::Goodbye { .. } => {
+                        panic!("idle disconnect sent process Goodbye")
+                    }
+                    _ => {}
+                }
+            }
+        }
+        pings
+    });
+    let cfg = test_runner_config(format!("http://{addr}"));
+    let runtime = test_runtime(&cfg);
+    let started = Instant::now();
+    let exit = tokio::time::timeout(
+        Duration::from_secs(5),
+        websocket_session_with_liveness(
+            &cfg,
+            vec![test_project("idle")],
+            "inst-idle",
+            &runtime,
+            short_websocket_liveness(),
+            std::future::pending::<()>(),
+        ),
+    )
+    .await
+    .expect("open socket with no inbound activity did not time out")
+    .unwrap();
+    assert_eq!(exit, RunnerSessionExit::TransportDisconnected);
+    assert!(started.elapsed() >= Duration::from_millis(400));
+    assert!(!runtime.shutdown_requested());
+    assert_eq!(runtime.coordinator.run_count(), 0);
+    assert!(
+        server.await.unwrap() >= 3,
+        "outgoing Pings must not extend the inbound deadline"
+    );
+}

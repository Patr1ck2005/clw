+#[tokio::test]
+async fn websocket_liveness_normal_reconnect_recovers_original_job_once() {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    let cwd = tempfile::tempdir().unwrap();
+    let command = if cfg!(windows) {
+        "Add-Content -LiteralPath executions.txt -Value once; while (-not (Test-Path -LiteralPath release)) { Start-Sleep -Milliseconds 20 }; [Console]::Out.Write('recovered')"
+    } else {
+        "printf 'once\\n' >> executions.txt; while [ ! -f release ]; do sleep 0.02; done; printf recovered"
+    };
+    let mut request = start_job_request(cwd.path(), command);
+    request.timeout_secs = 10;
+    let mut cfg = test_runner_config(format!("http://{addr}"));
+    let registry = cwd.path().join("projects");
+    std::fs::create_dir_all(&registry).unwrap();
+    cfg.project_registry_dir = Some(registry);
+    let runtime = test_runtime(&cfg);
+    let server_runtime = runtime.clone();
+    let release = cwd.path().join("release");
+    let server = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await.unwrap();
+        let mut ws = tokio_tungstenite::accept_async(stream).await.unwrap();
+        let first = read_register(&mut ws).await;
+        send_registered_ack(&mut ws).await;
+        ws.send(WsMessage::Text(
+            RunnerEnvelope::Request { request }
+                .to_json()
+                .unwrap()
+                .into(),
+        ))
+        .await
+        .unwrap();
+        let running_seq = loop {
+            if let RunnerEnvelope::JobUpdate { payload } = read_loopback_envelope(&mut ws).await {
+                if payload.job_id == "job-active"
+                    && payload.status == "running"
+                    && !payload.finished
+                {
+                    break payload.update_seq.expect("sequenced running update");
+                }
+            }
+        };
+        ws.send(WsMessage::Close(None)).await.unwrap();
+        drop(ws);
+
+        // Exercise the real supervisor/backoff and registration on the same
+        // RunnerRuntimeState. The Job request is sent exactly once above.
+        let (stream, _) = listener.accept().await.unwrap();
+        let mut ws = tokio_tungstenite::accept_async(stream).await.unwrap();
+        let second = read_register(&mut ws).await;
+        assert_eq!(second.runner_instance_id, first.runner_instance_id);
+        let inventory = second.job_inventory.unwrap();
+        assert!(inventory.active_complete);
+        let original = inventory
+            .jobs
+            .iter()
+            .find(|job| job.job_id == "job-active")
+            .unwrap();
+        assert_eq!(original.request_id, "req-active-job");
+        assert_eq!(original.status, "running");
+        assert!(original.update_seq >= running_seq);
+        assert!(!server_runtime.shutdown_requested());
+        assert_eq!(server_runtime.coordinator.run_count(), 0);
+        send_registered_ack(&mut ws).await;
+        std::fs::write(release, b"finish the original Job").unwrap();
+        loop {
+            if let RunnerEnvelope::JobUpdate { payload } = read_loopback_envelope(&mut ws).await {
+                if payload.job_id == "job-active" && payload.finished {
+                    assert_eq!(payload.exit_code, Some(0));
+                    assert!(payload.update_seq.expect("sequenced terminal update") > running_seq);
+                    break;
+                }
+            }
+        }
+        assert!(!server_runtime.shutdown_requested());
+        // Explicit process shutdown is the sole shutdown trigger in this test.
+        server_runtime.request_shutdown_signal();
+        loop {
+            if matches!(
+                read_loopback_envelope(&mut ws).await,
+                RunnerEnvelope::Goodbye { .. }
+            ) {
+                break;
+            }
+        }
+        ws.send(WsMessage::Close(None)).await.unwrap();
+    });
+    let exit = tokio::time::timeout(
+        Duration::from_secs(12),
+        supervise_stream_transports(
+            &cfg,
+            false,
+            "inst-original-job",
+            &runtime,
+            StreamSupervisorMode::Strict(StreamTransport::WebSocket),
+        ),
+    )
+    .await
+    .expect("real supervisor failed to reconnect and collect original Job")
+    .unwrap();
+    assert_eq!(exit, StreamSupervisorExit::Completed);
+    server.await.unwrap();
+    assert_eq!(
+        std::fs::read_to_string(cwd.path().join("executions.txt"))
+            .unwrap()
+            .lines()
+            .count(),
+        1
+    );
+    assert_eq!(runtime.coordinator.run_count(), 1);
+}

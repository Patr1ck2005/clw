+fn short_websocket_liveness() -> WebSocketLiveness {
+    // The production entry always passes WS_LIVENESS (30s/90s/30s).
+    // Private durations accelerate the identical socket/dispatch loop without
+    // a new protocol, runtime setting, or Tokio test-util dependency.
+    WebSocketLiveness {
+        ping_interval: Duration::from_millis(50),
+        inbound_idle_timeout: Duration::from_millis(450),
+        send_timeout: Duration::from_secs(2),
+    }
+}
+
+async fn read_loopback_envelope(
+    ws: &mut tokio_tungstenite::WebSocketStream<tokio::net::TcpStream>,
+) -> RunnerEnvelope {
+    loop {
+        let message = ws.next().await.unwrap().unwrap();
+        if message.is_text() {
+            return RunnerEnvelope::from_slice(message.into_text().unwrap().as_bytes()).unwrap();
+        }
+    }
+}

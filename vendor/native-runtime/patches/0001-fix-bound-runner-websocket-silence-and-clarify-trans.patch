+        let mut ws = tokio_tungstenite::accept_async(stream).await.unwrap();
+        read_register(&mut ws).await;
+        send_registered_ack(&mut ws).await;
+        let until = tokio::time::Instant::now() + Duration::from_secs(3);
+        let mut sent = 0;
+        while tokio::time::Instant::now() < until {
+            // Invalid UTF-8 binary frames exercise the discard path without
+            // flooding captured test logs with malformed-JSON diagnostics.
+            if ws.send(WsMessage::Binary(vec![0xff].into())).await.is_err() {
+                break;
+            }
+            sent += 1;
+            tokio::task::yield_now().await;
+        }
+        sent
+    });
+    let cfg = test_runner_config(format!("http://{addr}"));
+    let runtime = test_runtime(&cfg);
+    let exit = tokio::time::timeout(
+        Duration::from_secs(2),
+        websocket_session_with_liveness(
+            &cfg,
+            vec![test_project("malformed")],
+            "inst-malformed",
+            &runtime,
+            short_websocket_liveness(),
+            std::future::pending::<()>(),
+        ),
+    )
+    .await
+    .expect("invalid ready frames starved the inbound deadline")
+    .unwrap();
+    assert_eq!(exit, RunnerSessionExit::TransportDisconnected);
+    assert!(!runtime.shutdown_requested());
+    assert!(server.await.unwrap() > 10);
+}

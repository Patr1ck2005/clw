+#[tokio::test]
+async fn startup_catalog_skill_definition_shares_original_absolute_deadline() {
+    let (_root, runtime, project, auth) = startup_runtime("skills-definition").await;
+    let deadline = Instant::now() + Duration::from_millis(800);
+    let task = tokio::spawn({
+        let runtime = runtime.clone();
+        async move {
+            runtime
+                .startup_skills_catalog(&project, Some(&auth), deadline)
+                .await
+        }
+    });
+    let packages =
+        wait_for_runner_request_for_instance(&runtime, "skills-definition", "inst").await;
+    assert_eq!(packages.kind, "file_skill_list_packages");
+    tokio::time::sleep(Duration::from_millis(100)).await;
+    complete_patch_agent_request(&runtime, "skills-definition", &packages.request_id, 0,
+        r#"{"format":"webcodex.skill_package_list.v1","entries":[{"name":"demo","kind":"dir"}],"truncated":false}"#, "").await;
+    let definition =
+        wait_for_runner_request_for_instance(&runtime, "skills-definition", "inst").await;
+    assert_eq!(definition.kind, "file_skill_read_file");
+    let response = tokio::time::timeout(Duration::from_millis(750), task)
+        .await
+        .expect("definition must not reset discovery deadline")
+        .unwrap();
+    assert_eq!(json!(response)["status"], "unavailable");
+    assert_eq!(
+        runtime
+            .runner_registry
+            .cancel_request_dispatch_state(&definition.request_id)
+            .await,
+        None
+    );
+    assert!(probe_patch_agent_request(&runtime, "skills-definition")
+        .await
+        .is_none());
+    assert_eq!(
+        runtime
+            .runner_registry
+            .cancel_abandoned_sync_requests()
+            .await,
+        0
+    );
+}

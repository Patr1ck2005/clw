+/// Resolve the first valid registration for one id without probing Git or
+/// canonicalizing unrelated project roots. Registry filenames are not ids;
+/// retain the sorted-file precedence used by the full inventory loader.
+pub(crate) fn find_project_root_by_id(dir: &Path, project_id: &str) -> Option<PathBuf> {
+    let mut files = std::fs::read_dir(dir)
+        .ok()?
+        .flatten()
+        .map(|entry| entry.path())
+        .filter(|path| path.extension().and_then(|ext| ext.to_str()) == Some("toml"))
+        .collect::<Vec<_>>();
+    files.sort();
+    for file in files {
+        let Ok(content) = std::fs::read_to_string(file) else {
+            continue;
+        };
+        let Ok(project) = parse_runner_project_toml(&content) else {
+            continue;
+        };
+        if project.id == project_id {
+            let path = PathBuf::from(project.path);
+            return Some(
+                canonicalize_existing(&path)
+                    .ok()
+                    .filter(|path| path.is_dir())
+                    .unwrap_or(path),
+            );
+        }
+    }
+    None
+}

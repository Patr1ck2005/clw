+#[tokio::test]
+async fn startup_catalog_short_deadline_does_not_change_explicit_plugin_catalog_wait() {
+    let (_root, runtime, project, auth) = startup_runtime("catalog-explicit").await;
+    let task = tokio::spawn({
+        let runtime = runtime.clone();
+        async move { runtime.project_plugin_catalog(&project, Some(&auth)).await }
+    });
+    let request = wait_for_runner_request_for_instance(&runtime, "catalog-explicit", "inst").await;
+    tokio::time::sleep(Duration::from_millis(100)).await;
+    assert!(
+        !task.is_finished(),
+        "explicit discovery retains its original longer wait"
+    );
+    complete_plugin_catalog(&runtime, request).await;
+    assert_eq!(task.await.unwrap().unwrap().total_count, 0);
+}

+//! Startup status resolution must inspect one root, without a full Git inventory.
+
+use super::adapter::handle_lsp_operation;
+use crate::lsp_bridge::{parse_runner_lsp_result_envelope, RunnerLspPayload, RunnerLspRequest};
+use crate::webcodex_runner::config::RunnerPolicy;
+use crate::webcodex_runner::projects::project_git_probe_count;
+use std::fs;
+use std::path::Path;
+use webcodex_lsp::{LspSupervisor, LspSupervisorConfig};
+
+fn registration(dir: &Path, filename: &str, id: &str, root: &Path, disabled: bool) {
+    fs::write(
+        dir.join(filename),
+        format!(
+            "id = {id:?}\npath = {:?}\ndisabled = {disabled}\n",
+            root.to_string_lossy()
+        ),
+    )
+    .unwrap();
+}
+
+fn status(dir: &Path, id: &str, policy: &RunnerPolicy) -> serde_json::Value {
+    let supervisor = LspSupervisor::new(LspSupervisorConfig::default());
+    let response = handle_lsp_operation(
+        policy,
+        dir,
+        &supervisor,
+        &RunnerLspPayload {
+            project_id: id.to_string(),
+            request: RunnerLspRequest::Status,
+        },
+        1,
+    );
+    serde_json::to_value(
+        parse_runner_lsp_result_envelope(response.stdout.as_deref().unwrap()).unwrap(),
+    )
+    .unwrap()
+}
+
+#[test]
+fn startup_status_resolution_does_not_run_git_for_any_registered_project() {
+    let temp = tempfile::tempdir().unwrap();
+    let registry = temp.path().join("registry");
+    fs::create_dir(&registry).unwrap();
+    let target = temp.path().join("target");
+    fs::create_dir(&target).unwrap();
+    registration(
+        &registry,
+        "unrelated-filename.toml",
+        "target",
+        &target,
+        false,
+    );
+    for index in 0..135 {
+        registration(
+            &registry,
+            &format!("project-{index:03}.toml"),
+            &format!("other-{index}"),
+            &temp.path().join(format!("missing-{index}")),
+            false,
+        );
+    }
+    let before = project_git_probe_count();
+    let result = status(
+        &registry,
+        " target ",
+        &RunnerPolicy {
+            allow_cwd_anywhere: true,
+            ..Default::default()
+        },
+    );
+    assert_eq!(result["success"], true, "{result}");
+    assert_eq!(
+        project_git_probe_count(),
+        before,
+        "status must not invoke any Git probes"
+    );
+}
+
+#[test]
+fn startup_status_resolution_preserves_registration_precedence_and_policy() {
+    let temp = tempfile::tempdir().unwrap();
+    let registry = temp.path().join("registry");
+    fs::create_dir(&registry).unwrap();
+    let allowed = temp.path().join("allowed");
+    let forbidden = temp.path().join("forbidden");
+    fs::create_dir(&allowed).unwrap();
+    fs::create_dir(&forbidden).unwrap();
+    // Preserve the full inventory's first valid id even when that record is
+    // disabled. The adapter does not choose a later enabled duplicate.
+    registration(&registry, "a-first.toml", "demo", &forbidden, true);
+    registration(&registry, "z-later.toml", "demo", &allowed, false);
+    fs::write(registry.join("0-malformed.toml"), "invalid TOML").unwrap();
+    let policy = RunnerPolicy {
+        allowed_roots: vec![allowed.clone()],
+        ..Default::default()
+    };
+    let rejected = status(&registry, "demo", &policy);
+    assert_eq!(
+        rejected["error"]["code"], "invalid_project_path",
+        "{rejected}"
+    );
+    fs::remove_file(registry.join("a-first.toml")).unwrap();
+    assert_eq!(status(&registry, "demo", &policy)["success"], true);
+    assert_eq!(
+        status(&registry, "missing", &policy)["error"]["code"],
+        "unknown_project"
+    );
+    assert_eq!(
+        status(&registry, " ", &policy)["error"]["code"],
+        "unknown_project"
+    );
+}

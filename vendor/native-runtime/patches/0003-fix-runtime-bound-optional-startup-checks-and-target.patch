+
+// Lifecycle regressions: optional startup reads expire with their own exact
+// accepted request, rather than leaving abandoned entries or replaying them.
+use super::support::{
+    bootstrap_auth_context, complete_patch_agent_request, probe_patch_agent_request,
+    register_runner_project_at_path_with_capabilities, wait_for_runner_request_for_instance,
+};
+use crate::runner_protocol::{RunnerCapabilities, RunnerResultPayload, RunnerResultRequest};
+use crate::tool_runtime::ToolRuntime;
+use std::time::{Duration, Instant};
+use webcodex_core::plugin::{
+    PluginGatewayRequest, PluginGatewayResponse, PluginGatewayResponsePayload, ProjectPluginCatalog,
+};
+
+async fn startup_runtime(
+    client: &str,
+) -> (
+    tempfile::TempDir,
+    ToolRuntime,
+    crate::tool_runtime::ResolvedProject,
+    crate::auth::AuthContext,
+) {
+    let root = tempfile::tempdir().unwrap();
+    let runtime = ToolRuntime::new_for_tests();
+    let id = register_runner_project_at_path_with_capabilities(
+        &runtime,
+        client,
+        "demo",
+        root.path(),
+        RunnerCapabilities {
+            file_read: true,
+            native_tool_plugins: true,
+            skill_runtime: true,
+            ..Default::default()
+        },
+    )
+    .await;
+    let auth = bootstrap_auth_context();
+    let project = runtime
+        .resolve_project_input_for_auth(&id, Some(&auth))
+        .await
+        .unwrap();
+    (root, runtime, project, auth)
+}
+
+async fn complete_plugin_catalog(
+    runtime: &ToolRuntime,
+    request: crate::runner_protocol::RunnerRequest,
+) {
+    runtime
+        .runner_registry
+        .complete(RunnerResultPayload {
+            result: RunnerResultRequest {
+                client_id: request.client_id,
+                runner_instance_id: "inst".to_string(),
+                request_id: request.request_id,
+                exit_code: None,
+                stdout: None,
+                stderr: None,
+                stdout_truncated: false,
+                stderr_truncated: false,
+                duration_ms: None,
+                error: None,
+            },
+            command_execution_state: None,
+            mcp_gateway: None,
+            coding_agent: None,
+            plugin_gateway: Some(PluginGatewayResponse::success(
+                PluginGatewayResponsePayload::ProjectCatalog {
+                    catalog: ProjectPluginCatalog {
+                        catalog_revision: format!(
+                            "wc_plugcat_{}",
+                            webcodex_core::compact::encode([0xaa; 32])
+                        ),
+                        total_count: 0,
+                        entries: Vec::new(),
+                    },
+                },
+            )),
+        })
+        .await
+        .unwrap();
+}
+
+#[tokio::test]
+async fn startup_catalog_plugin_queue_timeout_clears_exact_pending_request() {
+    let (_root, runtime, project, auth) = startup_runtime("catalog-queued").await;
+    let started = Instant::now();
+    let response = runtime
+        .startup_plugin_catalog(
+            &project,
+            Some(&auth),
+            Instant::now() + Duration::from_millis(50),
+        )
+        .await;
+    assert_eq!(response.unwrap_err(), "plugin_runtime_unavailable");
+    assert!(
+        started.elapsed() >= Duration::from_millis(50),
+        "authorized catalog must enqueue and wait, not fail before dispatch admission"
+    );
+    assert!(probe_patch_agent_request(&runtime, "catalog-queued")
+        .await
+        .is_none());
+    assert_eq!(
+        runtime
+            .runner_registry
+            .cancel_abandoned_sync_requests()
+            .await,
+        0
+    );
+}
+
+#[tokio::test]
+async fn startup_catalog_plugin_dispatch_timeout_clears_original_without_replay() {
+    let (_root, runtime, project, auth) = startup_runtime("catalog-dispatched").await;
+    let task = tokio::spawn({
+        let runtime = runtime.clone();
+        async move {
+            runtime
+                .startup_plugin_catalog(
+                    &project,
+                    Some(&auth),
+                    Instant::now() + Duration::from_millis(500),
+                )
+                .await
+        }
+    });
+    let request =
+        wait_for_runner_request_for_instance(&runtime, "catalog-dispatched", "inst").await;
+    assert!(matches!(
+        request.plugin_gateway,
+        Some(PluginGatewayRequest::ProjectCatalog { .. })
+    ));
+    assert_eq!(
+        task.await.unwrap().unwrap_err(),
+        "plugin_runtime_unavailable"
+    );
+    assert_eq!(
+        runtime
+            .runner_registry
+            .cancel_request_dispatch_state(&request.request_id)
+            .await,
+        None
+    );
+    assert!(probe_patch_agent_request(&runtime, "catalog-dispatched")
+        .await
+        .is_none());
+    assert_eq!(
+        runtime
+            .runner_registry
+            .cancel_abandoned_sync_requests()
+            .await,
+        0
+    );
+}

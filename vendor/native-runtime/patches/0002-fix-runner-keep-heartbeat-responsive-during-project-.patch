+struct ProjectScanGate {
+    release: std::sync::mpsc::Sender<()>,
+    started: oneshot::Receiver<()>,
+    calls: Arc<AtomicUsize>,
+    max_active: Arc<AtomicUsize>,
+    first_cancelled: Arc<AtomicBool>,
+}
+
+fn gated_project_scanner(runtime: &RunnerRuntimeState) -> ProjectScanGate {
+    let (release, wait) = std::sync::mpsc::channel();
+    let wait = Mutex::new(wait);
+    let (started_tx, started) = oneshot::channel();
+    let started_tx = Mutex::new(Some(started_tx));
+    let calls = Arc::new(AtomicUsize::new(0));
+    let active = Arc::new(AtomicUsize::new(0));
+    let max_active = Arc::new(AtomicUsize::new(0));
+    let first_cancelled = Arc::new(AtomicBool::new(false));
+    let (load_calls, load_max, cancelled) =
+        (calls.clone(), max_active.clone(), first_cancelled.clone());
+    runtime.project_scanner.set_loader(Arc::new(move |stop| {
+        let call = load_calls.fetch_add(1, Ordering::SeqCst);
+        let count = active.fetch_add(1, Ordering::SeqCst) + 1;
+        load_max.fetch_max(count, Ordering::SeqCst);
+        if call == 0 {
+            started_tx.lock().unwrap().take().unwrap().send(()).unwrap();
+            wait.lock()
+                .unwrap()
+                .recv_timeout(Duration::from_secs(5))
+                .expect("test scan release missing");
+            cancelled.store(stop.load(Ordering::SeqCst), Ordering::SeqCst);
+        }
+        active.fetch_sub(1, Ordering::SeqCst);
+        vec![synthetic_project_summary(
+            if call == 0 { 999 } else { 1 },
+            None,
+        )]
+    }));
+    ProjectScanGate {
+        release,
+        started,
+        calls,
+        max_active,
+        first_cancelled,
+    }
+}

+#[derive(Default)]
+struct StreamingScanState {
+    next_session: u64,
+    session: Option<u64>,
+    running: bool,
+    stop: Option<std::sync::Arc<AtomicBool>>,
+    completed: Option<Result<Vec<RunnerProjectSummary>, ()>>,
+}
+
+// Shared by the retained Runner runtime, rather than a socket. A disconnected
+// session cannot leave one blocking scan behind and start another on reconnect.
+#[derive(Default)]
+pub(super) struct StreamingProjectScanner {
+    state: std::sync::Mutex<StreamingScanState>,
+    pub(super) changed: tokio::sync::Notify,
+    #[cfg(test)]
+    loader: std::sync::Mutex<
+        Option<std::sync::Arc<dyn Fn(&AtomicBool) -> Vec<RunnerProjectSummary> + Send + Sync>>,
+    >,
+}
+
+pub(super) struct StreamingProjectScanSession {
+    scanner: std::sync::Arc<StreamingProjectScanner>,
+    session: u64,
+}
+
+impl StreamingProjectScanner {
+    pub(super) fn session(self: &std::sync::Arc<Self>) -> StreamingProjectScanSession {
+        let mut state = self.state.lock().unwrap();
+        state.next_session += 1;
+        let session = state.next_session;
+        state.session = Some(session);
+        state.completed = None;
+        if let Some(stop) = &state.stop {
+            stop.store(true, Ordering::SeqCst);
+        }
+        StreamingProjectScanSession {
+            scanner: self.clone(),
+            session,
+        }
+    }
+
+    #[cfg(test)]
+    pub(super) fn set_loader(
+        &self,
+        loader: std::sync::Arc<dyn Fn(&AtomicBool) -> Vec<RunnerProjectSummary> + Send + Sync>,
+    ) {
+        *self.loader.lock().unwrap() = Some(loader);
+    }
+
+    pub(super) fn cancel(&self) {
+        if let Some(stop) = &self.state.lock().unwrap().stop {
+            stop.store(true, Ordering::SeqCst);
+        }
+    }
+}
+
+impl StreamingProjectScanSession {
+    pub(super) fn start(&self, cfg: &RunnerConfig, shutdown: std::sync::Arc<AtomicBool>) -> bool {
+        let mut state = self.scanner.state.lock().unwrap();
+        if state.session != Some(self.session) || state.running || shutdown.load(Ordering::SeqCst) {
+            return false;
+        }
+        state.running = true;
+        state.completed = None;
+        let stop = std::sync::Arc::new(AtomicBool::new(false));
+        state.stop = Some(stop.clone());
+        drop(state);
+        let scanner = self.scanner.clone();
+        let session = self.session;
+        let cfg = cfg.clone();
+        #[cfg(test)]
+        let loader = scanner.loader.lock().unwrap().clone();
+        tokio::task::spawn_blocking(move || {
+            let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                #[cfg(test)]
+                if let Some(loader) = loader {
+                    return loader(stop.as_ref());
+                }
+                // This flag stops only an obsolete metadata scan. It reaches
+                // the existing per-file and owned Git-tree cancellation path;
+                // ordinary transport disconnect never cancels independent Jobs.
+                RunnerProjectCache::default().get_with_shutdown(&cfg, Some(stop.as_ref()))
+            }))
+            .map_err(|_| ());
+            let mut state = scanner.state.lock().unwrap();
+            state.running = false;
+            state.stop = None;
+            if state.session == Some(session) {
+                state.completed = Some(result);
+            }
+            drop(state);
+            scanner.changed.notify_one();
+        });
+        true
+    }
+
+    fn take_completed(&self) -> Option<Result<Vec<RunnerProjectSummary>, ()>> {
+        let mut state = self.scanner.state.lock().unwrap();
+        if state.session == Some(self.session) {
+            state.completed.take()
+        } else {
+            None
+        }
+    }
+}
+
+impl Drop for StreamingProjectScanSession {
+    fn drop(&mut self) {
+        let mut state = self.scanner.state.lock().unwrap();
+        if state.session == Some(self.session) {
+            state.session = None;
+            state.completed = None;
+            if let Some(stop) = &state.stop {
+                stop.store(true, Ordering::SeqCst);
+            }
+        }
+    }
+}
+
+pub(super) async fn stream_projects_for_registration(
+    cfg: &RunnerConfig,
+    runtime: &RunnerRuntimeState,
+) -> Result<Vec<RunnerProjectSummary>, &'static str> {
+    let session = runtime.project_scanner.session();
+    let mut started = false;
+    loop {
+        if runtime.shutdown_requested() {
+            return Err("runner_shutdown");
+        }
+        if !started {
+            started = session.start(cfg, runtime.shutdown_flag());
+        }
+        if started {
+            if let Some(result) = session.take_completed() {
+                return result.map_err(|_| "project_inventory_scan_panicked");
+            }
+        }
+        tokio::select! {
+            _ = runtime.project_scanner.changed.notified() => {},
+            _ = runtime.wait_for_shutdown() => return Err("runner_shutdown"),
+        }
+    }
+}

+    assert_eq!(page.projects[0].id, synthetic_project_summary(1, None).id);
+    assert!(old_rx.try_recv().is_err());
+    assert!(gate.first_cancelled.load(Ordering::SeqCst));
+    assert_eq!(gate.calls.load(Ordering::SeqCst), 2);

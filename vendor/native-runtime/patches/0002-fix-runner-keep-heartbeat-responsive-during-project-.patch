+#[tokio::test(flavor = "current_thread")]
+async fn websocket_liveness_project_scan_blocked_keeps_pings_and_pongs_on_original_socket() {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    let cfg = test_runner_config(format!("http://{addr}"));
+    let runtime = test_runtime(&cfg);
+    let gate = gated_project_scanner(&runtime);
+    let release = gate.release;
+    let scan_started = gate.started;
+    let server = tokio::spawn(async move {
+        let (stream, _) = listener.accept().await.unwrap();
+        let mut ws = tokio_tungstenite::accept_async(stream).await.unwrap();
+        read_register(&mut ws).await;
+        send_registered_ack(&mut ws).await;
+        let mut stale = inventory_status("degraded", "obsolete", 1, 0);
+        stale.last_error_code = Some("project_inventory_stale_generation".to_string());
+        ws.send(WsMessage::Text(
+            RunnerEnvelope::ProjectInventoryStatus { status: stale }
+                .to_json()
+                .unwrap()
+                .into(),
+        ))
+        .await
+        .unwrap();
+        scan_started.await.unwrap();
+        let started = Instant::now();
+        let mut pings = 0;
+        let mut pong_seen = false;
+        let mut released = false;
+        loop {
+            match read_loopback_envelope(&mut ws).await {
+                RunnerEnvelope::Ping { ts } => {
+                    pings += 1;
+                    ws.send(WsMessage::Text(
+                        RunnerEnvelope::Pong { ts }.to_json().unwrap().into(),
+                    ))
+                    .await
+                    .unwrap();
+                    if pings == 3 {
+                        ws.send(WsMessage::Text(
+                            RunnerEnvelope::Ping { ts: 1234 }.to_json().unwrap().into(),
+                        ))
+                        .await
+                        .unwrap();
+                    }
+                    if pings == 14 {
+                        assert!(
+                            started.elapsed() > short_websocket_liveness().inbound_idle_timeout
+                        );
+                        release.send(()).unwrap();
+                        released = true;
+                    }
+                }
+                RunnerEnvelope::Pong { ts: 1234 } => {
+                    assert!(
+                        !released,
+                        "incoming Ping must be answered during the blocked scan"
+                    );
+                    pong_seen = true;
+                }
+                RunnerEnvelope::ProjectInventoryPage { page } if released => {
+                    assert_eq!(page.projects[0].id, synthetic_project_summary(999, None).id);
+                    assert!(pong_seen);
+                    ws.send(WsMessage::Close(None)).await.unwrap();
+                    return pings;
+                }
+                _ => {}
+            }
+        }
+    });
+    let exit = tokio::time::timeout(
+        Duration::from_secs(5),
+        websocket_session_with_liveness(
+            &cfg,
+            vec![test_project("initial")],
+            "original-scan-socket",
+            &runtime,
+            short_websocket_liveness(),
+            std::future::pending::<()>(),
+        ),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert_eq!(exit, RunnerSessionExit::TransportDisconnected);
+    assert!(server.await.unwrap() >= 14);
+    assert_eq!(gate.calls.load(Ordering::SeqCst), 1);
+    assert!(!gate.first_cancelled.load(Ordering::SeqCst));
+    assert!(!runtime.shutdown_requested());
+}

+#[tokio::test(flavor = "current_thread")]
+async fn streaming_project_scan_coalesces_dirty_and_discards_superseded_snapshot() {
+    let cfg = test_runner_config("http://127.0.0.1:1".to_string());
+    let runtime = test_runtime(&cfg);
+    let gate = gated_project_scanner(&runtime);
+    let (tx, mut rx) = mpsc::channel(8);
+    let mut coordinator =
+        StreamingProjectInventoryCoordinator::new(Some(ProjectInventorySync::new(vec![
+            test_project("initial"),
+        ])));
+    coordinator.refresh_from_current_projects(
+        StreamTransport::WebSocket,
+        &cfg,
+        &runtime,
+        &tx,
+        "first",
+    );
+    gate.started.await.unwrap();
+    for _ in 0..8 {
+        coordinator.refresh_from_current_projects(
+            StreamTransport::WebSocket,
+            &cfg,
+            &runtime,
+            &tx,
+            "newer",
+        );
+    }
+    assert_eq!(gate.calls.load(Ordering::SeqCst), 1);
+    assert!(rx.try_recv().is_err());
+    gate.release.send(()).unwrap();
+    finish_project_scan(
+        &mut coordinator,
+        StreamTransport::WebSocket,
+        &cfg,
+        &runtime,
+        &tx,
+    )
+    .await;
+    let page = match rx.recv().await.unwrap() {
+        RunnerEnvelope::ProjectInventoryPage { page } => page,
+        other => panic!("expected fresh page: {other:?}"),
+    };
+    assert_eq!(page.projects[0].id, synthetic_project_summary(1, None).id);
+    assert_eq!(gate.calls.load(Ordering::SeqCst), 2);
+    assert_eq!(gate.max_active.load(Ordering::SeqCst), 1);
+    assert!(!gate.first_cancelled.load(Ordering::SeqCst));
+    assert!(rx.try_recv().is_err());
+    assert!(!runtime.shutdown_requested());
+}

+#[test]
+fn terminal_waits_preserve_both_timeout_spellings_when_matched_or_already_terminal() {
+    let temp = tempdir().unwrap();
+    let db = Database::open(&temp.path().join("job-terminal-timeouts.db")).unwrap();
+    let owner = principal('a');
+    for status in ["timeout", "timed_out"] {
+        let mut terminal = fact(status, T0 + 20);
+        terminal.status = status.into();
+        terminal.outcome = "timed_out".into();
+        let created = db
+            .create_job_terminal_wait(&owner, waiting(status, status, T0 + 8_100), T0)
+            .unwrap();
+        let matched = db.match_job_terminal_fact(&terminal, T0 + 20).unwrap();
+        assert_eq!(matched.matched_count, 1);
+        let stored = db
+            .read_job_terminal_wait(&owner, &created.wait.wait_id, T0 + 21)
+            .unwrap();
+        assert_eq!(stored.terminal_status.as_deref(), Some(status));
+        assert_eq!(stored.terminal_outcome.as_deref(), Some("timed_out"));
+
+        let immediate = db
+            .create_job_terminal_wait(
+                &owner,
+                NewJobTerminalWait {
+                    idempotency_key: format!("immediate-{status}"),
+                    already_terminal: Some(terminal),
+                    ..waiting(status, status, T0 + 8_100)
+                },
+                T0 + 22,
+            )
+            .unwrap();
+        assert_eq!(immediate.wait.terminal_status.as_deref(), Some(status));
+        assert_eq!(
+            immediate.wait.terminal_outcome.as_deref(),
+            Some("timed_out")
+        );
+    }
+}

{
  "name": "clw-web-workspace",
  "version": "0.8.0-preview.2",
  "license": "MIT",
  "private": true,
  "clw_data_epoch": 1,
  "clw_task_schema_max": 4,
  "type": "module",
  "scripts": {
    "harness": "python -X utf8 -B scripts/serve_harness.py --open",
    "test:harness": "python -X utf8 -B -m unittest discover -s tests -p test_harness_*.py",
    "test": "node --test tests/control-center.test.mjs tests/live.test.mjs tests/task-client.test.mjs tests/journal-client.test.mjs tests/account-view.test.mjs tests/asset-client.test.mjs tests/product-status.test.mjs",
    "test:all": "python -B scripts/verify_integrated_workbench.py",
    "preview": "python -X utf8 -B scripts/web_host_launcher.py",
    "start": "python -X utf8 -B scripts/web_host_launcher.py",
    "release:prepare": "python -X utf8 -B scripts/web_workspace_release.py prepare",
    "legacy:start": "python -B scripts/workbench_release.py start --bootstrap --open",
    "legacy:preview": "python -B scripts/workbench_release.py start --mode development --open",
    "legacy:release:prepare": "python -B scripts/workbench_release.py prepare --ref HEAD"
  }
}
